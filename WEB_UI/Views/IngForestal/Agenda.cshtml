@{
    ViewData["Title"] = "Agenda de Visitas - Ingeniero Forestal";
    Layout = "~/Views/Shared/_LayoutIngForestal.cshtml";
}

<div class="tecnico-dashboard">

    <div class="psa-page-header">
        <div>
            <h1><i class="fa-solid fa-calendar-days"></i> Agenda de Visitas</h1>
            <p>Visualiza y gestiona tus visitas técnicas en el calendario mensual.</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button class="btn btn-outline-psa btn-sm" onclick="irHoy()">Hoy</button>
            <button class="btn btn-psa btn-sm" onclick="programarVisita()">Programar Visita</button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 360px; gap: 24px;">
        
        <!-- Calendario -->
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title">
                    <i class="fa-solid fa-calendar"></i> Calendario
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-psa" onclick="mesAnterior()">◀</button>
                    <span id="ag-mes-label" style="margin:0 15px; font-weight:bold;"></span>
                    <button class="btn btn-sm btn-outline-psa" onclick="mesSiguiente()">▶</button>
                </div>
            </div>
            <div class="psa-card-body" style="padding: 1rem; overflow-x: auto;">
                <div id="ag-semanas"></div>
            </div>
            <div class="psa-card-footer" style="display: flex; gap: 20px; padding: 10px 1rem; border-top: 1px solid #e2e8f0;">
                <div style="display: flex; align-items: center; gap: 6px;"><div style="width:10px; height:10px; border-radius:50%; background:#c9922a;"></div> Pendiente</div>
                <div style="display: flex; align-items: center; gap: 6px;"><div style="width:10px; height:10px; border-radius:50%; background:#1d4f8a;"></div> En Proceso</div>
                <div style="display: flex; align-items: center; gap: 6px;"><div style="width:10px; height:10px; border-radius:50%; background:#2d8653;"></div> Aprobada</div>
            </div>
        </div>

        <!-- Visitas del Día -->
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title">
                    <i class="fa-solid fa-list-ul"></i> Visitas del Día
                </div>
                <span id="ag-dia-label" style="font-size:0.75rem; background:#e8f5ee; padding:4px 12px; border-radius:20px;">—</span>
            </div>
            <div class="psa-card-body" style="padding: 0; max-height: 500px; overflow-y: auto;" id="ag-lista-dia">
                <div style="text-align:center; padding:40px;">Cargando...</div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/pages/ingforestal/agenda.js" asp-append-version="true"></script>
}