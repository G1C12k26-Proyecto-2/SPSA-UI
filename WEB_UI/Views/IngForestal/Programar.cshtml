@{
    ViewData["Title"] = "Programar Visita - Ingeniero Forestal";
    Layout = "~/Views/Shared/_LayoutIngForestal.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ingforestal/programar.css" asp-append-version="true" />
}

<div class="IngForestal-dashboard">

    <!-- ===== PAGE HEADER ===== -->
    <div class="psa-page-header">
        <div>
            <span class="subtitle">Nueva Visita Técnica</span>
            <h1>
                <i class="fas fa-calendar-plus" style="color: var(--psa-leaf); font-size: 1.4rem;"></i>
                Programar Visita Técnica
            </h1>
            <p>Complete los 3 pasos para registrar una nueva visita de evaluación.</p>
        </div>
    </div>

    <!-- ===== STEPPER ===== -->
    <div class="pr-stepper" role="list" aria-label="Pasos del formulario">
        <div class="pr-step activo" role="listitem" aria-current="step">
            <div class="pr-step-num">1</div>
            <div class="pr-step-label">
                <div class="pr-step-titulo">Solicitud</div>
                <div class="pr-step-sub">Seleccionar finca</div>
            </div>
        </div>
        <div class="pr-step" role="listitem">
            <div class="pr-step-num">2</div>
            <div class="pr-step-label">
                <div class="pr-step-titulo">Detalles</div>
                <div class="pr-step-sub">Fecha y logística</div>
            </div>
        </div>
        <div class="pr-step" role="listitem">
            <div class="pr-step-num">3</div>
            <div class="pr-step-label">
                <div class="pr-step-titulo">Confirmar</div>
                <div class="pr-step-sub">Revisar y guardar</div>
            </div>
        </div>
    </div>

    <!-- ===== LAYOUT PRINCIPAL ===== -->
    <div style="display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; align-items: start;">

        <!-- COLUMNA IZQUIERDA: FORMULARIO -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- ══════ PASO 1: SELECCIÓN DE SOLICITUD ══════ -->
            <div class="pr-seccion activa" id="pr-seccion-1">
                <div class="psa-card">
                    <div class="psa-card-header">
                        <div class="psa-card-title">
                            <i class="fas fa-file-alt"></i> Seleccionar Solicitud Pendiente
                        </div>
                        <span style="font-size: 0.7rem; color: var(--psa-muted);">Elija la finca que desea evaluar</span>
                    </div>
                    <div class="psa-card-body">
                        <!-- Búsqueda -->
                        <div class="pr-buscar-solicitud">
                            <i class="fas fa-search pr-search-ic"></i>
                            <input type="text" id="pr-buscar-sol" class="form-control form-control-sm"
                                   placeholder="Buscar por finca, propietario o ubicación..."
                                   aria-label="Buscar solicitud">
                        </div>

                        <!-- Error selección -->
                        <div class="pr-field-error" id="pr-sol-err" style="margin-bottom: 12px; display: none;">
                            <i class="fas fa-triangle-exclamation"></i>
                            Debe seleccionar una solicitud para continuar.
                        </div>

                        <!-- Lista de solicitudes (se llena con JS) -->
                        <div class="pr-solicitudes-lista" id="pr-lista-solicitudes"
                             role="radiogroup" aria-label="Solicitudes pendientes">
                            <div class="pr-solicitudes-empty">
                                <i class="fas fa-spinner fa-spin"></i>
                                <p>Cargando solicitudes...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════ PASO 2: DETALLES ══════ -->
            <div class="pr-seccion" id="pr-seccion-2">
                <div class="psa-card">
                    <div class="psa-card-header">
                        <div class="psa-card-title">
                            <i class="fas fa-clock"></i> Detalles de la Visita
                        </div>
                        <span style="font-size: 0.7rem; color: var(--psa-muted);">Defina fecha, hora y logística</span>
                    </div>
                    <div class="psa-card-body">
                        <div class="pr-form-grid">
                            <!-- Fecha -->
                            <div class="pr-field">
                                <label>Fecha de visita <span class="req">*</span></label>
                                <div class="pr-input-icon-wrap">
                                    <i class="fas fa-calendar pr-input-icon"></i>
                                    <input type="date" id="pr-fecha" class="form-control form-control-sm">
                                </div>
                                <span class="pr-field-error" id="pr-fecha-err">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    Seleccione una fecha válida (hoy o posterior).
                                </span>
                            </div>

                            <!-- Hora -->
                            <div class="pr-field">
                                <label>Hora de inicio <span class="req">*</span></label>
                                <div class="pr-input-icon-wrap">
                                    <i class="fas fa-clock pr-input-icon"></i>
                                    <input type="time" id="pr-hora" class="form-control form-control-sm">
                                </div>
                                <span class="pr-field-error" id="pr-hora-err">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    Indique la hora de inicio de la visita.
                                </span>
                            </div>

                            <!-- Duración estimada -->
                            <div class="pr-field">
                                <label>Duración estimada <span class="req">*</span></label>
                                <select id="pr-duracion" class="form-select form-select-sm">
                                    <option value="">Seleccione...</option>
                                    <option value="60">1 hora</option>
                                    <option value="120">2 horas</option>
                                    <option value="180">3 horas</option>
                                    <option value="240">4 horas</option>
                                    <option value="360">Medio día</option>
                                    <option value="480">Día completo</option>
                                </select>
                                <span class="pr-field-error" id="pr-duracion-err">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    Seleccione la duración estimada.
                                </span>
                            </div>

                            <!-- Transporte -->
                            <div class="pr-field">
                                <label>Medio de transporte <span class="req">*</span></label>
                                <select id="pr-transporte" class="form-select form-select-sm">
                                    <option value="">Seleccione...</option>
                                    <option value="vehiculo-propio">Vehículo propio</option>
                                    <option value="vehiculo-institucional">Vehículo institucional</option>
                                    <option value="transporte-publico">Transporte público</option>
                                    <option value="otro">Otro</option>
                                </select>
                                <span class="pr-field-error" id="pr-transporte-err">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    Seleccione el medio de transporte.
                                </span>
                            </div>

                            <!-- Objetivo -->
                            <div class="pr-field span-2">
                                <label>Objetivo de la visita <span class="req">*</span> <span class="hint">(mín. 10 caracteres)</span></label>
                                <textarea id="pr-objetivo" rows="3" class="form-control form-control-sm"
                                          placeholder="Describa el propósito técnico de esta evaluación..."></textarea>
                                <span class="pr-field-error" id="pr-objetivo-err">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    Describa el objetivo de la visita (mín. 10 caracteres).
                                </span>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="pr-divider">
                            <i class="fas fa-wrench"></i> Información adicional
                        </div>

                        <div class="pr-form-grid">
                            <!-- Equipo / materiales -->
                            <div class="pr-field span-2">
                                <label>Equipo y materiales a llevar</label>
                                <textarea id="pr-equipo" rows="2" class="form-control form-control-sm"
                                          placeholder="Ej: GPS, cámara, libreta de campo, metro, brújula..."></textarea>
                            </div>

                            <!-- Observaciones -->
                            <div class="pr-field span-2">
                                <label>Observaciones de coordinación</label>
                                <textarea id="pr-observacion" rows="2" class="form-control form-control-sm"
                                          placeholder="Notas para la coordinación con el propietario, puntos de acceso, etc."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════ PASO 3: CONFIRMACIÓN ══════ -->
            <div class="pr-seccion" id="pr-seccion-3">
                <div class="psa-card">
                    <div class="psa-card-header">
                        <div class="psa-card-title">
                            <i class="fas fa-circle-check" style="color: var(--psa-blue);"></i> Confirmar Visita
                        </div>
                        <span style="font-size: 0.7rem; color: var(--psa-muted);">Revise los datos antes de guardar</span>
                    </div>
                    <div class="psa-card-body">
                        <div class="pr-confirmacion">
                            <div class="pr-confirmacion-icon">📋</div>
                            <h3>Resumen de la Visita</h3>
                            <p>
                                Verifique que toda la información sea correcta.<br>
                                Al confirmar, se notificará al sistema y quedará registrado en la auditoría.
                            </p>
                            <div class="pr-confirmacion-detalle" id="pr-conf-detalle">
                                <!-- Generado por JS -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== ACCIONES DE NAVEGACIÓN ===== -->
            <div class="pr-form-actions">
                <a class="btn btn-outline-psa btn-sm" href="@Url.Action("ListaSolicitudes", "IngForestal")">
                    <i class="fas fa-xmark"></i> Cancelar
                </a>
                <div class="pr-form-actions-right">
                    <button class="btn btn-outline-psa btn-sm" id="pr-btn-anterior" style="display:none;">
                        <i class="fas fa-arrow-left"></i> Anterior
                    </button>
                    <button class="btn btn-psa btn-sm" id="pr-btn-siguiente">
                        Siguiente <i class="fas fa-arrow-right"></i>
                    </button>
                    <button class="btn btn-psa btn-sm" id="pr-btn-guardar" style="display:none;">
                        <i class="fas fa-calendar-check"></i> Confirmar y Guardar
                    </button>
                </div>
            </div>

        </div><!-- /columna izquierda -->
        <!-- COLUMNA DERECHA: RESUMEN -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- Tarjeta resumen -->
            <div class="psa-card">
                <div class="psa-card-header">
                    <div class="psa-card-title">
                        <i class="fas fa-receipt"></i> Resumen
                    </div>
                    <span style="font-size: 0.7rem; color: var(--psa-muted);">Se actualiza en tiempo real</span>
                </div>
                <div class="pr-resumen-body">
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Finca</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-finca">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Propietario</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-prop">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Ubicación</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-ubic">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Hectáreas</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-has">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Vegetación</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-veg">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Fecha de visita</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-fecha">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Hora</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-hora">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Duración estimada</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-duracion">—</span>
                    </div>
                    <div class="pr-resumen-item">
                        <span class="pr-resumen-label">Transporte</span>
                        <span class="pr-resumen-valor vacio" id="pr-res-transporte">—</span>
                    </div>
                </div>
            </div>

            <!-- Alerta informativa -->
            <div class="pr-resumen-alerta">
                <i class="fas fa-circle-info" style="margin-top: 2px; flex-shrink: 0;"></i>
                <span>Al guardar, la visita quedará registrada en el sistema y se generará un aviso automático de auditoría.</span>
            </div>

        </div><!-- /columna derecha -->

    </div><!-- /layout grid -->

</div><!-- /IngForestal-dashboard -->
<!-- ===== TOAST ===== -->
<div id="pr-toast">
    <i class="fas fa-check-circle"></i>
    <span id="pr-toast-msg">Acción realizada.</span>
</div>

@section Scripts {
    <script src="~/js/pages/ingforestal/programar.js" asp-append-version="true"></script>
}