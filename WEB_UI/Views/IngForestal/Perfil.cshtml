@{
    ViewData["Title"] = "Mi Perfil";
    ViewData["Breadcrumb"] = "Mi Perfil";
    Layout = "~/Views/Shared/_LayoutIngForestal.cshtml";
}

@section Scripts {
    <script src="~/js/pages/usuarios/perfil.js"></script>
}

<div class="psa-page-header">
    <div>
        <span class="subtitle">Mi Cuenta</span>
        <h1>Mi Perfil</h1>
        <p>Información personal asociada a su cuenta</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">

        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title">
                    <i class="fas fa-user-circle"></i> Datos del Usuario
                </div>
            </div>

            <div class="psa-card-body">

                <input type="hidden" id="txtIdUsuario" />

                <div class="mb-3">
                    <label class="form-label">ID</label>
                    <div id="perfilId" class="psa-detail-value" style="font-family:monospace;">
                        Cargando...
                    </div>
                </div>

                <div class="mb-3">
                    <label for="txtUserName" class="form-label">Nombre de Usuario</label>
                    <input type="text" id="txtUserName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="txtFullName" class="form-label">Nombre Completo</label>
                    <input type="text" id="txtFullName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="txtEmail" class="form-label">Correo Electrónico</label>
                    <input type="email" id="txtEmail" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <div>
                        <span id="perfilRol" class="psa-badge psa-badge-gold">
                            Cargando...
                        </span>
                    </div>
                    <small class="text-muted">
                        El rol solo puede ser actualizado por un usuario administrador.
                    </small>
                </div>

                <button type="button" id="btnGuardarPerfil" class="btn btn-psa">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>

            </div>
        </div>

        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title">
                    <i class="fas fa-shield-halved"></i> Seguridad
                </div>
            </div>

            <div class="psa-card-body">
                <div class="d-flex align-items-center justify-content-between p-3 rounded"
                     style="background:var(--psa-cream);border:1px solid var(--psa-border);">

                    <div class="d-flex align-items-center gap-3">
                        <div class="psa-tl-dot gold">
                            <i class="fas fa-lock"></i>
                        </div>

                        <div>
                            <div style="font-size:0.85rem;font-weight:500;color:var(--psa-ink);">
                                Contraseña
                            </div>
                            <div style="font-size:0.78rem;color:var(--psa-muted);">
                                ••••••••••••
                            </div>
                        </div>
                    </div>

                    <a class="btn btn-outline-psa btn-sm" href="/Login/RecuperarContrasena">
                        <i class="fas fa-key"></i> Cambiar Contraseña
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>