@{
    ViewData["Title"] = "Registrar Finca";
    ViewData["Breadcrumb"] = "Registrar Finca";
}

<div class="psa-page-header">
    <div>
        <span class="subtitle">Registro de Propiedades</span>
        <h1>Registrar Nueva Finca</h1>
        <p>Complete los datos para solicitar ingreso al programa PSA</p>
    </div>
</div>

<div id="seccionBorradores" class="mb-4" style="display:none;">
    <h5 class="mb-3"><i class="fas fa-floppy-disk text-success"></i> Borradores Guardados</h5>
    <div id="listaBorradores" class="row g-3"></div>
</div>

<div class="psa-card">
    <div class="psa-card-header">
        <div class="psa-card-title"><i class="fas fa-tree"></i> Datos de la Propiedad</div>
        <span class="psa-badge psa-badge-muted">Estado inicial: Pendiente</span>
    </div>
    <div class="psa-card-body">
        <form id="frmCrear">
            <h5 class="mb-3"><i class="fas fa-map-pin text-success"></i> Ubicación</h5>
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label class="form-label-psa">Nombre de la Finca</label>
                    <input id="txtNombre" type="text" class="form-control" placeholder="Nombre de la finca" />
                </div>
                <div class="col-12">
                    <label class="form-label-psa">Seleccionar Ubicación en Mapa</label>
                    <div id="map" style="height:350px; border-radius:12px; border:1px solid #2d5a3d;"></div>
                    <small class="text-muted mt-1 d-block">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        <span id="lblCoordenadas">Haz clic en el mapa para seleccionar la ubicación</span>
                    </small>
                    <input type="hidden" id="hfLatitud" />
                    <input type="hidden" id="hfLongitud" />
                </div>

                <div class="col-md-4">
                    <label class="form-label-psa">Provincia</label>
                    <input id="ddlProvincia" type="text" class="form-control" placeholder="Provincia" />
                    <small class="text-muted">Auto-detectada al hacer clic en el mapa</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Cantón</label>
                    <input id="ddlCanton" type="text" class="form-control" placeholder="Cantón" />
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Distrito</label>
                    <input id="ddlDistrito" type="text" class="form-control" placeholder="Distrito" />
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Tamaño (Hectáreas)</label>
                    <input id="txtHectareas" type="number" class="form-control" placeholder="Ej: 85.5" min="0.1" step="0.1" />
                    <small class="text-muted">Debe ser mayor que 0</small>
                </div>
            </div>

            <h5 class="mb-3 mt-4"><i class="fas fa-leaf text-success"></i> Características Ambientales</h5>

            <div class="mb-3">
                <label class="form-label-psa">Tipo de Superficie</label>
                <div class="psa-chip-group" data-field="pendiente">
                    <span class="psa-chip" data-value="PLANA">Plana</span>
                    <span class="psa-chip selected" data-value="INCLINADA">Inclinada</span>
                    <span class="psa-chip" data-value="MUY_INCLINADA">Muy Inclinada</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-psa">Tipo de Vegetación</label>
                <div class="psa-chip-group" data-field="vegetacion">
                    <span class="psa-chip selected" data-value="BOSQUE_PRIMARIO">Bosque Primario</span>
                    <span class="psa-chip" data-value="BOSQUE_SECUNDARIO">Bosque Secundario</span>
                    <span class="psa-chip" data-value="PLANTACION_FORESTAL">Plantación Forestal</span>
                    <span class="psa-chip" data-value="PASTO_ESCASA">Pasto</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-psa">Recursos Hídricos</label>
                <div class="psa-chip-group" data-multi="true" data-field="hidrico">
                    <span class="psa-chip" data-value="rios">Ríos o Quebradas</span>
                    <span class="psa-chip" data-value="nacientes">Nacientes</span>
                    <span class="psa-chip" data-value="ninguno">Sin recurso hídrico</span>
                </div>
                <div class="d-flex gap-2 align-items-center mt-2">
                    <label class="form-label-psa mb-0" style="white-space:nowrap;">Cantidad de nacientes:</label>
                    <input id="txtNacientes" type="number" class="form-control" value="0" min="0" style="width:80px;" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-psa">Uso de Suelo (selección múltiple)</label>
                <div class="psa-chip-group" data-multi="true" data-field="usosuelo">
                    <span class="psa-chip selected" data-value="Conservación">Conservación</span>
                    <span class="psa-chip selected" data-value="Protección Forestal">Protección Forestal</span>
                    <span class="psa-chip" data-value="Reforestación">Reforestación</span>
                    <span class="psa-chip" data-value="Agroforestal">Agroforestal</span>
                    <span class="psa-chip" data-value="Ganadería">Ganadería</span>
                    <span class="psa-chip" data-value="Mixto">Mixto</span>
                </div>
            </div>

            <h5 class="mb-3 mt-4"><i class="fas fa-folder-open" style="color:var(--psa-gold);"></i> Fotografías y Documentos</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label-psa">Fotografías</label>
                    <div class="psa-upload">
                        <i class="fas fa-camera"></i>
                        <p>Arrastra imágenes o haz clic</p>
                        <small>JPG, PNG · máx. 10MB</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label-psa">Documentos Legales</label>
                    <div class="psa-upload">
                        <i class="fas fa-file-arrow-up"></i>
                        <p>Plano catastrado, escritura, etc.</p>
                        <small>PDF · máx. 25MB</small>
                    </div>
                </div>
            </div>

            <hr />
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-psa" id="btnEnviar"><i class="fas fa-paper-plane"></i> Enviar Solicitud</button>
                <button type="button" class="btn btn-outline-psa" id="btnBorrador"><i class="fas fa-floppy-disk"></i> Guardar Borrador</button>
                <a class="btn btn-outline-psa" asp-controller="Fincas" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Pages/Fincas/crearfinca.js"></script>
    <script>
        function initMap() {
            if (window.crearFincaInstance) window.crearFincaInstance.InitMap();
        }

        $(document).ready(() => {
            if (typeof google !== 'undefined' && typeof google.maps !== 'undefined') {
                if (window.crearFincaInstance) window.crearFincaInstance.InitMap();
            }
        });
    </script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initMap">
    </script>
}