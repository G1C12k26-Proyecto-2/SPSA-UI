@{
    ViewData["Title"] = "Detalle Finca";
    ViewData["Breadcrumb"] = "Finca La Catarata";
}

<div class="psa-page-header">
    <div>
        <span class="subtitle">Mis Propiedades</span>
        <h1 id="detNombre">—</h1>
        <p><span id="detProvincia">—</span> · <span id="detCanton">—</span>, <span id="detDistrito">—</span> · <span id="detHectareas">—</span> hectáreas</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-psa btn-sm" asp-controller="Fincas" asp-action="Editar"><i class="fas fa-pen"></i> Editar</a>
        <a class="btn btn-outline-psa btn-sm" asp-controller="Fincas" asp-action="Index"><i class="fas fa-arrow-left"></i> Volver</a>
    </div>
</div>

<!-- Banner de estado -->
<div class="d-flex align-items-center gap-3 p-3 rounded mb-3" style="background:var(--psa-pale);border:1px solid #b8dfc8;">
    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:var(--psa-leaf);color:#fff;font-size:1rem;">
        <i class="fas fa-check"></i>
    </div>
    <div>
        <div id="detEstado" style="font-family:'Fraunces',serif;font-size:1.05rem;font-weight:600;color:var(--psa-forest);">—</div>
        <div style="font-size:0.78rem;color:var(--psa-muted);">Solicitud registrada el <span id="detFechaSolicitudBanner">—</span></div>
    </div>
    <div class="ms-auto text-end">
        <div id="detPago" style="font-family:'Fraunces',serif;font-size:1.5rem;font-weight:700;color:var(--psa-forest);">—</div>
        <div style="font-size:0.68rem;color:var(--psa-muted);">Pago mensual</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title"><i class="fas fa-tree"></i> Datos de la Propiedad</div>
            </div>
            <div class="psa-detail-grid">
                <div class="psa-detail-item"><div class="psa-detail-label">Propietario</div><div class="psa-detail-value" id="detPropietario">—</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Vegetación</div><div class="psa-detail-value"><span class="psa-badge psa-badge-green" id="detVegetacion">—</span></div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Recursos Hídricos</div><div class="psa-detail-value"><span class="psa-badge psa-badge-blue" id="detHidrico">—</span></div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Pendiente</div><div class="psa-detail-value" id="detPendiente">—</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Nacientes</div><div class="psa-detail-value" id="detNacientes">—</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Uso de Suelo</div><div class="psa-detail-value" id="detUsoSuelo">—</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Ubicación</div><div class="psa-detail-value"><span id="detProvincia2">—</span> · <span id="detCanton2">—</span> · <span id="detDistrito2">—</span></div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Registro</div><div class="psa-detail-value" id="detFecha">—</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title"><i class="fas fa-receipt"></i> Desglose del Pago Mensual</div>
            </div>
            <div class="psa-card-body">
                <table class="table mb-3">
                    <thead>
                        <tr><th>Concepto</th><th class="text-end">Monto</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Monto Base <small id="desgBaseLabel" class="text-muted"></small></td><td class="text-end fw-medium" id="desgBase"></td></tr>
                        <tr><td>Ajuste Vegetación <span id="desgVegPct" class="psa-badge psa-badge-green" style="font-size:0.58rem;"></span></td><td class="text-end text-success fw-medium" id="desgVeg"></td></tr>
                        <tr><td>Ajuste Hídrico <span id="desgHidPct" class="psa-badge psa-badge-blue" style="font-size:0.58rem;"></span></td><td class="text-end text-success fw-medium" id="desgHid"></td></tr>
                        <tr><td>Ajuste Pendiente <small id="desgPendLabel" class="text-muted"></small></td><td class="text-end" id="desgPend"></td></tr>
                        <tr><td colspan="2"><small id="desgTotalPct" class="text-muted"></small></td></tr>
                    </tbody>
                </table>
                <div class="p-3 rounded text-center" style="background:var(--psa-pale);">
                    <div class="form-label-psa">Total Mensual</div>
                    <div id="desgTotal" style="font-family:'Fraunces',serif;font-size:2rem;font-weight:700;color:var(--psa-forest);"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title"><i class="fas fa-folder-open"></i> Documentos Adjuntos</div>
            </div>
            <div class="psa-card-body">
                <div id="listaFotos"></div>
                <div id="listaDocumentos"></div>
                <div id="sinArchivos" class="text-muted text-center py-3" style="display:none;">No hay archivos adjuntos.</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="psa-card">
            <div class="psa-card-header">
                <div class="psa-card-title"><i class="fas fa-clipboard-check"></i> Evaluación Técnica</div>
            </div>
            <div class="psa-detail-grid">
                <div class="psa-detail-item"><div class="psa-detail-label">Ingeniero</div><div class="psa-detail-value">Ing. Roberto Rojas</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Fecha Visita</div><div class="psa-detail-value">10 jul 2023</div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Resultado</div><div class="psa-detail-value"><span class="psa-badge psa-badge-green">Aprobada</span></div></div>
                <div class="psa-detail-item"><div class="psa-detail-label">Fecha Aprobación</div><div class="psa-detail-value">15 jul 2023</div></div>
            </div>
            <div class="psa-card-body border-top">
                <div class="form-label-psa mb-2">Observaciones del Ingeniero</div>
                <p class="p-3 bg-light rounded mb-0" style="font-size:0.82rem;line-height:1.6;">Propiedad en excelente estado de conservación. Bosque primario bien preservado con alta biodiversidad. Presencia de quebrada principal con caudal constante. Se recomienda aprobación para programa PSA modalidad conservación. Área verificada: 62 ha coinciden con plano catastrado.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Pages/Fincas/detallefinca.js" asp-append-version="true"></script>
}

<!-- HISTORIAL PAGOS -->
