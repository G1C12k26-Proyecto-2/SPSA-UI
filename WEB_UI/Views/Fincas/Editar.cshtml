@{
    ViewData["Title"] = "Editar Finca";
    ViewData["Breadcrumb"] = "Editar Finca";
}

<div class="psa-page-header">
    <div>
        <span class="subtitle">Mis Propiedades</span>
        <h1>Editar Finca</h1>
    </div>
    <a class="btn btn-outline-psa btn-sm" asp-controller="Fincas" asp-action="Index"><i class="fas fa-arrow-left"></i> Volver</a>
</div>

<div class="alert alert-warning d-flex align-items-center gap-2">
    <i class="fas fa-info-circle"></i> Solo puede editar mientras la solicitud no haya sido evaluada.
</div>

<div class="psa-card">
    <div class="psa-card-header">
        <div class="psa-card-title"><i class="fas fa-pen"></i> Editar: Finca Las Palmas</div>
        <span class="psa-badge psa-badge-gold">En Revisión</span>
    </div>
    <div class="psa-card-body">
        <form id="frmEditar">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-psa">Nombre</label>
                    <input id="txtNombre" type="text" class="form-control" placeholder="Nombre de la finca" />
                </div>
                <div class="col-md-6">
                    <label class="form-label-psa">Hectáreas</label>
                    <input id="txtHectareas" type="number" class="form-control" min="0.1" step="0.1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Provincia</label>
                    <input id="txtProvincia" type="text" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Cantón</label>
                    <input id="txtCanton" type="text" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label-psa">Distrito</label>
                    <input id="txtDistrito" type="text" class="form-control" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label-psa">Nacientes</label>
                    <input id="txtNacientes" type="number" class="form-control" min="0" />
                </div>
                <div class="col-md-6">
                    <label class="form-label-psa">Uso de Suelo</label>
                    <input id="txtUsoSuelo" type="text" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label-psa">Tipo de Vegetación</label>
                    <div class="psa-chip-group">
                        <span class="psa-chip chip-option" data-grupo="vegetacion" data-valor="BOSQUE_PRIMARIO">Bosque Primario</span>
                        <span class="psa-chip chip-option" data-grupo="vegetacion" data-valor="BOSQUE_SECUNDARIO">Bosque Secundario</span>
                        <span class="psa-chip chip-option" data-grupo="vegetacion" data-valor="PLANTACION_FORESTAL">Plantación Forestal</span>
                        <span class="psa-chip chip-option" data-grupo="vegetacion" data-valor="PASTO_ESCASA">Pasto</span>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label-psa">Pendiente</label>
                    <div class="psa-chip-group">
                        <span class="psa-chip chip-option" data-grupo="pendiente" data-valor="PLANA">Plana</span>
                        <span class="psa-chip chip-option" data-grupo="pendiente" data-valor="INCLINADA">Inclinada</span>
                        <span class="psa-chip chip-option" data-grupo="pendiente" data-valor="MUY_INCLINADA">Muy Inclinada</span>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label-psa">Recursos Hídricos</label>
                    <div class="psa-chip-group">
                        <span class="psa-chip chip-option" data-grupo="hidrico" data-valor="true">Sí tiene ríos/quebradas</span>
                        <span class="psa-chip chip-option" data-grupo="hidrico" data-valor="false">Sin recurso hídrico</span>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label-psa">Documentos y Fotografías</label>
                    <div id="listaFotos"></div>
                    <div id="listaDocumentos"></div>
                    <div id="sinArchivos" style="display:none;" class="text-muted small">No hay archivos adjuntos.</div>
                </div>
            </div>
            <hr />
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-psa" id="btnGuardar"><i class="fas fa-save"></i> Guardar Cambios</button>
                <a class="btn btn-outline-psa" asp-controller="Fincas" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Pages/Fincas/editarfinca.js" asp-append-version="true"></script>
    <script>
        $(document).on('click', '.chip-option', function () {
            const grupo = $(this).data('grupo');
            $('.chip-option[data-grupo="' + grupo + '"]').removeClass('selected');
            $(this).addClass('selected');
        });
    </script>
}
