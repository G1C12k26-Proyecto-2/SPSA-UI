@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script async
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initMap">
    </script>   

    <script src="~/js/pages/location/locationtest.js"></script>
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>Prueba de Ubicaciones</h2>
    </div>

    <div class="mb-3">
        <label class="form-label">Mapa</label>
        <div id="map" style="height: 400px; width: 100%; border: 1px solid #ccc; border-radius: 8px;"></div>
    </div>

    <div class="mb-3">
    <label class="form-label">Ubicación seleccionada</label>
    <div id="selectedAddressLine" class="form-control bg-light" style="min-height: 38px;">
        No hay ubicación seleccionada.
    </div>
</div>

    <div class="mb-3">
        <label for="txtAddress" class="form-label">Dirección</label>
        <input id="txtAddress" class="form-control" type="text" placeholder="Ingrese una dirección" />
    </div>

    <div class="mb-3">
        <button id="btnGeocode" class="btn btn-primary">Buscar ubicación</button>
        <button id="btnSaveLocation" class="btn btn-success">Guardar ubicación</button>
    </div>

    <hr />

    <div class="mb-3">
        <label for="txtFormattedAddress" class="form-label">Dirección formateada</label>
        <input id="txtFormattedAddress" class="form-control" type="text" readonly />
    </div>

    <div class="mb-3">
        <label for="txtLatitude" class="form-label">Latitud</label>
        <input id="txtLatitude" class="form-control" type="text" readonly />
    </div>

    <div class="mb-3">
        <label for="txtLongitude" class="form-label">Longitud</label>
        <input id="txtLongitude" class="form-control" type="text" readonly />
    </div>

    <div class="mb-3">
        <label for="txtPlaceId" class="form-label">PlaceId</label>
        <input id="txtPlaceId" class="form-control" type="text" readonly />
    </div>

    <hr />

    <div class="mb-3">
        <button id="btnRetrieveAll" class="btn btn-secondary">Consultar ubicaciones guardadas</button>
    </div>

    <div class="mb-3">
        <pre id="locationsResult" class="p-3 bg-light border rounded"></pre>
    </div>
    <div class="mb-3">
        <div id="map" style="height: 450px; width: 100%; border: 1px solid #ccc; border-radius: 8px;"></div>
    </div>


</div>